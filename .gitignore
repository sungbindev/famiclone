node_modules/
/build/
*.tgz
.cache/

# 工具链里的二进制是生成物，由 vscode/tools/build/build-cc65.mjs 组装到扩展目录，不入库
vscode/toolchain/

# 目标运行库由 vscode/tools/build/build-libs.mjs 生成
vscode/targets/*/lib/*.o
vscode/targets/*/lib/*.lib
apps/**/build/

# 软盘镜像目录里的盘内文件、生成的镜像、BIOS 与模拟器是第三方文件或生成物，不入库；构建脚本入库
apps/sb2000/disk/content/

# 由扩展的同步命令生成，含本机路径
compile_flags.txt
**/.vscode/c_cpp_properties.json