node_modules/
/build/
packages/*/build/
*.tgz
.cache/

# 工具链包里的二进制是生成物，由 tools/ 下的脚本组装，不入库
packages/fcdev-cc65/bin/
packages/fcdev-cc65/include/
packages/fcdev-cc65/asminc/
packages/fcdev-cc65/lib/
packages/fcdev-cc65/cfg/
packages/fcdev-cc65/manifest.json
packages/fcdev-cc65/LICENSE

# 模拟器包里的程序、许可、第三方声明与清单是生成物，由 tools/build-ember.mjs 从 Ember 的发布产物组装，不入库
packages/fcdev-ember/bin/
packages/fcdev-ember/LICENSE
packages/fcdev-ember/THIRD_PARTY_NOTICES.txt
packages/fcdev-ember/manifest.json

# 调试 SDK 的生成物：generated/ 由 ember 的 npm run schema 生成，dist/debug/ 与 debug-sdk/docs/ 由 fcdev 的 debug-sdk:* 脚本生成
packages/fcdev/debug-sdk/generated/
packages/fcdev/dist/
packages/fcdev/debug-sdk/docs/

# 目标运行库由 tools/build-libs.mjs 生成
packages/fcdev/targets/*/lib/*.o
packages/fcdev/targets/*/lib/*.lib
apps/**/build/

# 软盘镜像目录里的盘内文件、生成的镜像、BIOS 与模拟器是第三方文件或生成物，不入库；构建脚本入库
apps/sb2000/disk/content/

# 由 fcdev sync 生成，含本机路径
compile_flags.txt
**/.vscode/c_cpp_properties.json