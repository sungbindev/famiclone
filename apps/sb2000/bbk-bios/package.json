{
  "name": "bbk-bios",
  "version": "0.1.0",
  "private": true,
  "description": "BBK BIOS ported to the SB2000 (6576 mode), built as BIOS.BBK",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "port": "node tools/port-bios.mjs",
    "build": "node tools/build-bios.mjs",
    "verify": "node tools/run-bbk.mjs 900 build/work/shots/dos.png dos dir",
    "test": "node --test \"test/**/*.test.mjs\""
  }
}
