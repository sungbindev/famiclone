; ------------------------------------------------------------------------
; 名称：platform.inc
; 说明：FBASIC 移植版的平台符号与宏：SB2000 的画面布局、新增的零页单元。
; 作者：sungbin
; 邮箱：sungbin@3578.cn
; 日期：2026-11-17
; 备注：6576 的显示布局（见 packages/fcdev/docs/sb2000/03-硬件说明.md）：名称表在 CRAM，每个图块 2 字节，低字节图案号，
;       高字节高 4 位调色板组、低 4 位是图案号的第 11-8 位；NES 的名称表 0、1 对应 6576 的页 0、1（CRAM 地址 = (NES 地址 & $FFF) * 2）。
;       背景图案表 0、1 放在扩展显存 $D000、$E000（图案号 $D00、$E00 起，DOS 不用这一带），精灵图案表 0、1 放在字符 RAM $2000、$3000（$2008 位 3-2 选）。
; ------------------------------------------------------------------------
        .include        "sb2000.inc"
        .include        "shell.inc"

; 原版没用过的零页单元（不能是原版直接引用的，也不能落在它按下标访问的范围里：$34-$45 的数值工作区、$B9-$DA 的声道表）
V_TILE_HIGH     = $93                   ; 新图块条目的高字节：背景图案表 $0D + 表号（调色板组在高 4 位，写文字时不改）
V_TMP1          = $94                   ; 临时单元
V_TMP2          = $95
V_ADDR_TMP      = $96                   ; 设显存地址时暂存高字节
V_GAME_LEN_LO   = $DE                   ; GAME 命令搬内置程序时：要搬的字节数
V_GAME_LEN_HI   = $DF
V_GAME_PAGE     = $E6                   ; GAME 命令搬内置程序时：源所在的扩展 RAM 页（0 起）
V_COPY_SRC      = $DE                   ; SAVE、LOAD 复制程序文本时的源、目的指针与长度（各 2 字节，NMI 不用这几个单元）
V_COPY_DST      = $EB
V_COPY_LEN      = $F1

; 写一个图块的图案号到名称表当前地址，并把地址移到下一个图块：A = 图案号，A 不变。
; 图块条目的高字节（调色板组与图案表位）原样保留，所以改写文字不会改变那个位置的颜色（原版的调色板组放在属性表里，改文字也不改颜色）。
.macro  put_tile
        sta     $2007
        bit     $2007
.endmacro
