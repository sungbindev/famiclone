; ------------------------------------------------------------------------
; 名称：defs.inc
; 说明：runnes 的寄存器地址、内存分配、零页变量与错误码。
; 作者：sungbin
; 邮箱：sungbin@3578.cn
; 日期：2026-11-22
; 备注：程序是 32K 的程序映像，运行时只依赖 $0000-$07FF、$6000-$7FFF 与自己的窗口；
;       $0200-$02EF 放换页例程，$02F0-$02F1 放进入游戏的参数，两者运行期间不能被覆盖。
; ------------------------------------------------------------------------

; 寄存器
PPU_CTRL    = $2000
PPU_MASK    = $2001
PPU_SCROLL  = $2005
PPU_ADDR    = $2006
PPU_DATA    = $2007
JOY1        = $4016                 ; 写：手柄锁存与键盘扫描
KEYBOARD    = $4017                 ; 读：键盘状态；写：APU 帧计数器
PRAM_PAGE   = $5000                 ; 程序页：位 7 为 1 选程序 RAM，为 0 选 ROM
MIRROR_REG  = $5200                 ; 位 0 为 1 是水平镜像，位 2 为 1 是 32K 模式
FDC_DCR     = $5500                 ; 写：数据率
FDC_DOR     = $5501                 ; 写：数字输出寄存器（马达、复位、中断）
FDC_DATA_W  = $5505                 ; 写：数据寄存器
FDC_MSR     = $5604                 ; 读：主状态寄存器
FDC_DATA_R  = $5605                 ; 读：数据寄存器
VEC_RESET   = $FFFC

; DOS 把命令行放在 WRAM 的这个地址，以 0 结尾
TAIL_SRC    = $682E

; 内存分配
TAIL        = $0600                 ; 命令行副本，最多 62 字节
SECBUF      = $0300                 ; 扇区缓冲，512 字节
CLUSTERS    = $0500                 ; 文件的簇号表，每项 2 字节，最多 81 项
NAME83      = $0700                 ; 要找的 8.3 文件名，11 字节
FAT_BASE    = $6000                 ; WRAM：FAT 的 9 个扇区（$6000-$71FF）
CHR_BUF     = $6000                 ; WRAM：CHR 暂存（$6000-$7FFF），与 FAT 错开使用
HAND_MIRROR = $02F0                 ; 进入游戏时写 $5200 的值
HAND_PAGE   = $02F1                 ; 进入游戏时写 $5000 的值

; 零页变量
ZS          = $10                   ; 源指针（2）
ZD          = $12                   ; 目标指针（2）
ZN          = $14                   ; 字节数（2）
ZPAGE       = $16                   ; 复制到程序 RAM 时 $5000 的值
T0          = $17
T1          = $18
LBA         = $19                   ; 逻辑扇区号（2）
CYL         = $1B
HEAD        = $1C
SECT        = $1D
CURCYL      = $1E                   ; 磁头当前的柱面
TMO         = $1F                   ; 超时计数（2）
TMO2        = $21                   ; 复位校验计数（2）
CL          = $23                   ; 当前簇（2）
FSIZE       = $25                   ; 文件大小（2，超过 64K 按 64K 处理）
FCL         = $27                   ; 文件首簇（2）
PRG         = $29                   ; PRG 字节数（2）
CHR         = $2B                   ; CHR 字节数（2）
PAY         = $2D                   ; PRG 加 CHR（2）
NSEC        = $2F                   ; 文件占用的扇区数
K           = $30                   ; 扇区序号 / 计数
IDX         = $31                   ; 簇表的字节偏移
P           = $32                   ; 负载（去掉 16 字节头之后）已写入的字节数（2）
CNT         = $34                   ; 本扇区要用的字节数（2）
N1          = $36                   ; 写入程序 RAM 的字节数（2）
DIFF        = $38                   ; PRG 剩余部分（2）
REM         = $3A                   ; 本扇区写入 CHR 的字节数（2）
MIRROR_VAL  = $3C                   ; 对应 $5200 的值
TMP         = $3D                   ; 临时（2）
ERRIDX      = $3F                   ; 错误码
ROW         = $40                   ; 文字位置：行
COL         = $41                   ; 文字位置：列
NSEC_ALL    = $42                   ; 文件占用的扇区总数（簇链遍历会改动 TMP，所以另存）
RES_ST0     = $44                   ; 读扇区结束时的结果：ST0
RES_ST1     = $45                   ; 读扇区结束时的结果：ST1
RES_ST2     = $46                   ; 读扇区结束时的结果：ST2

; 错误码（显示时用作消息表的下标）
ERR_USAGE   = 1
ERR_OPEN    = 2
ERR_HEADER  = 3
ERR_MAPPER  = 4
ERR_SIZE    = 5
ERR_TRUNC   = 6
ERR_READ    = 7
ERR_DISK    = 8
