{
  "plugin": "mmc3",
  "image": {
    "mapper": 4,
    "prgKiB": 256,
    "chrKiB": 128
  },
  "steps": [
    {
      "expectMap": [
        {
          "address": "$8000",
          "storage": "prg",
          "offset": 0
        },
        {
          "address": "$A000",
          "storage": "prg",
          "offset": 0
        },
        {
          "address": "$C000",
          "storage": "prg",
          "offset": 245760
        },
        {
          "address": "$E000",
          "storage": "prg",
          "offset": 253952
        },
        {
          "address": "$0000",
          "storage": "chr",
          "offset": 0,
          "bus": "ppu"
        },
        {
          "address": "$6000",
          "storage": "prg-ram",
          "offset": 0
        }
      ]
    },
    {
      "write": "$8000",
      "value": 6
    },
    {
      "write": "$8001",
      "value": 3
    },
    {
      "expectMap": [
        {
          "address": "$8000",
          "storage": "prg",
          "offset": 24576
        }
      ]
    },
    {
      "write": "$8000",
      "value": 7
    },
    {
      "write": "$8001",
      "value": 5
    },
    {
      "expectMap": [
        {
          "address": "$A000",
          "storage": "prg",
          "offset": 40960
        }
      ]
    },
    {
      "write": "$8000",
      "value": 70
    },
    {
      "expectMap": [
        {
          "address": "$8000",
          "storage": "prg",
          "offset": 245760
        },
        {
          "address": "$C000",
          "storage": "prg",
          "offset": 24576
        },
        {
          "address": "$E000",
          "storage": "prg",
          "offset": 253952
        }
      ]
    },
    {
      "write": "$8000",
      "value": 0
    },
    {
      "write": "$8001",
      "value": 4
    },
    {
      "expectMap": [
        {
          "address": "$0000",
          "storage": "chr",
          "offset": 4096,
          "bus": "ppu"
        },
        {
          "address": "$0400",
          "storage": "chr",
          "offset": 5120,
          "bus": "ppu"
        }
      ]
    },
    {
      "write": "$8000",
      "value": 2
    },
    {
      "write": "$8001",
      "value": 9
    },
    {
      "expectMap": [
        {
          "address": "$1000",
          "storage": "chr",
          "offset": 9216,
          "bus": "ppu"
        }
      ]
    },
    {
      "write": "$8000",
      "value": 128
    },
    {
      "expectMap": [
        {
          "address": "$1000",
          "storage": "chr",
          "offset": 4096,
          "bus": "ppu"
        },
        {
          "address": "$0000",
          "storage": "chr",
          "offset": 9216,
          "bus": "ppu"
        }
      ]
    },
    {
      "expectNametable": [
        {
          "address": "$2400",
          "a10": true
        },
        {
          "address": "$2800",
          "a10": false
        }
      ]
    },
    {
      "write": "$A000",
      "value": 1
    },
    {
      "expectNametable": [
        {
          "address": "$2400",
          "a10": false
        },
        {
          "address": "$2800",
          "a10": true
        }
      ]
    },
    {
      "write": "$A001",
      "value": 0
    },
    {
      "expectMap": [
        {
          "address": "$6000",
          "unmapped": true
        }
      ]
    },
    {
      "write": "$A001",
      "value": 128
    },
    {
      "expectMap": [
        {
          "address": "$6000",
          "storage": "prg-ram",
          "offset": 0
        }
      ]
    }
  ]
}
