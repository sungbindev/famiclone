{
  "id": "test-cnrom",
  "name": "CNROM（测试用）",
  "version": "1.0.0",
  "apiVersion": 1,
  "publisher": "Ember 测试",
  "description": "只用于测试：mapper 3，写 $8000-$FFFF 选择 8K 的 CHR 页（无总线冲突），用来运行 ppu_read_buffer 并测试寄存器回调。",
  "host": ["fc"],
  "match": [{ "mapper": 3 }],
  "storage": [
    { "id": "prg", "kind": "rom", "from": "file.prg" },
    { "id": "chr", "kind": "rom", "from": "file.chr", "fallback": { "kind": "ram", "size": 8192 } },
    { "id": "prg-ram", "kind": "ram", "size": 8192 }
  ],
  "windows": [
    { "id": "prg-ram", "bus": "cpu", "range": "$6000-$7FFF", "storage": "prg-ram", "size": 8192, "initial": 0, "access": "rw" },
    { "id": "prg-low", "bus": "cpu", "range": "$8000-$BFFF", "storage": "prg", "size": 16384, "initial": "first", "access": "r" },
    { "id": "prg-high", "bus": "cpu", "range": "$C000-$FFFF", "storage": "prg", "size": 16384, "initial": "last", "access": "r" },
    { "id": "chr", "bus": "ppu", "range": "$0000-$1FFF", "storage": "chr", "size": 8192, "initial": 0, "access": "rw" }
  ],
  "registers": [{ "bus": "cpu", "range": "$8000-$FFFF", "write": true }],
  "state": [{ "name": "chrBank", "bits": 8, "description": "CHR 的 8K bank 号" }]
}
