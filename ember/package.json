{
  "name": "ember",
  "productName": "Ember",
  "version": "0.2.2",
  "private": true,
  "description": "Ember：FC 与学习机模拟器，Electron 外壳与 C++ 核心。",
  "author": "sungbin <sungbin@3578.cn>",
  "license": "GPL-3.0-only",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "schema": "node tools/schema-gen/schema-gen.mjs",
    "core:build": "node tools/build/build-core.mjs",
    "core:test": "node tools/build/test-core.mjs",
    "win32:build": "node tools/build/build-win32.mjs",
    "win32:test": "node tools/build/test-win32.mjs",
    "win32:start": "node tools/build/start-win32.mjs",
    "win32:check": "node tools/check/check-win32-ui-kit.mjs && node tools/check/check-win32-imports.mjs",
    "win32:reference": "node win32/ui-kit/tools/reference/run-compare.mjs",
    "win32:probe-package": "node tools/build/pack-win32-probe.mjs",
    "plugins:pack": "node tools/build/pack-plugins.mjs",
    "help:build": "node tools/build/build-help.mjs",
    "start": "npm run schema && npm run help:build && npm run core:build && electron-forge start",
    "typecheck": "npm run schema && tsc --noEmit",
    "lint": "oxlint --deny-warnings src tools test win32/ui-kit/tools",
    "boundaries": "npm run schema && node tools/check/check-modules.mjs",
    "debug-sdk:check": "npm --prefix ../packages/ember-debug-sdk run check",
    "test": "npm run schema && vitest run",
    "check": "npm run typecheck && npm run lint && npm run boundaries && npm run help:build && vitest run && npm run core:test && npm run debug-sdk:check",
    "package": "npm run schema && npm run help:build && npm run core:build && electron-forge package",
    "package:win": "npm run schema && npm run help:build && node tools/build/build-core.mjs --arch x64 && electron-forge package --platform win32 --arch x64",
    "make:win": "npm run schema && npm run help:build && node tools/build/build-core.mjs --arch x64 && electron-forge make --platform win32 --arch x64",
    "update:publish": "node tools/build/publish-update.mjs",
    "package:mac": "bash tools/build/package-mac.sh"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "cmake-js": "^8.0.0",
    "electron": "^45.2.1",
    "jsdom": "^29.1.1",
    "node-addon-api": "^8.9.2",
    "oxlint": "^1.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1"
  }
}
