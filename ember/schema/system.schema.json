{
  "$comment": "系统模块：应用版本与核心版本。用于验证从界面到 C++ 核心的整条请求链路。",
  "module": "system",
  "types": {},
  "requests": {
    "version": {
      "description": "返回应用版本与核心版本。",
      "params": { "type": "object", "properties": {}, "required": [] },
      "result": {
        "type": "object",
        "properties": {
          "appVersion": { "type": "string", "minLength": 1, "description": "应用版本，取自安装包的版本号" },
          "coreVersion": { "type": "string", "minLength": 1, "description": "核心版本，取自核心的构建参数" }
        },
        "required": ["appVersion", "coreVersion"]
      }
    }
  },
  "mainRequests": {
    "openLogDirectory": {
      "description": "用系统的文件管理器打开日志目录（目录不存在时先创建）；路径由主进程决定，界面不能指定。",
      "params": { "type": "object", "properties": {}, "required": [] },
      "result": { "type": "object", "properties": {}, "required": [] },
      "errors": ["system.logDirectoryUnavailable"]
    },
    "openHelp": {
      "description": "在应用内弹出帮助文档窗口（已经打开时提到最前）；文档是随应用带的静态页面，位置由主进程决定，界面不能指定。",
      "params": { "type": "object", "properties": {}, "required": [] },
      "result": { "type": "object", "properties": {}, "required": [] },
      "errors": ["system.helpUnavailable"]
    }
  },
  "events": {}
}
