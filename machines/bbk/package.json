{
  "name": "bbk",
  "version": "0.1.0",
  "private": true,
  "description": "BBK learning computer BIOS/DOS source tooling",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node tools/gasm-check.mjs Bios.asm && node tools/gasm-check.mjs Command.asm && node tools/gasm-check.mjs Smcdos.asm",
    "match": "node tools/match-rom.mjs Bios.asm --rom",
    "align": "node tools/align-rom.mjs Bios.asm --rom",
    "port": "node tools/port-bios.mjs",
    "build": "node tools/build-bios.mjs",
    "verify": "node tools/run-bbk.mjs 900 build/shots/dos.png dos dir",
    "probe": "node tools/probe-fc.mjs",
    "test": "node --test \"test/**/*.test.mjs\""
  }
}
