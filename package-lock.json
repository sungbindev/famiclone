{
  "name": "famiclone-workspace",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "famiclone-workspace",
      "version": "0.1.0",
      "license": "Apache-2.0",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "node_modules/@rujianjs/fcdev-cc65": {
      "resolved": "packages/fcdev-cc65",
      "link": true
    },
    "node_modules/@rujianjs/fcdev-emulator": {
      "resolved": "packages/fcdev-emulator",
      "link": true
    },
    "node_modules/create-fcdev": {
      "resolved": "packages/create-fcdev",
      "link": true
    },
    "node_modules/fcdev": {
      "resolved": "packages/fcdev",
      "link": true
    },
    "packages/create-fcdev": {
      "version": "0.4.0",
      "license": "Apache-2.0",
      "bin": {
        "create-fcdev": "bin/create-fcdev.mjs"
      },
      "engines": {
        "node": ">=22"
      }
    },
    "packages/fcdev": {
      "version": "0.4.0",
      "license": "Apache-2.0",
      "bin": {
        "fcdev": "bin/fcdev.mjs"
      },
      "engines": {
        "node": ">=22"
      },
      "optionalDependencies": {
        "@rujianjs/fcdev-cc65": "0.4.0",
        "@rujianjs/fcdev-emulator": "0.4.0"
      }
    },
    "packages/fcdev-cc65": {
      "name": "@rujianjs/fcdev-cc65",
      "version": "0.4.0",
      "cpu": [
        "x64"
      ],
      "license": "Zlib",
      "os": [
        "win32"
      ]
    },
    "packages/fcdev-emulator": {
      "name": "@rujianjs/fcdev-emulator",
      "version": "0.4.0",
      "cpu": [
        "x64"
      ],
      "license": "GPL-3.0-only",
      "os": [
        "win32"
      ]
    }
  }
}
