{
  "name": "famiclone-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "famiclone 仓库的工作区：fcdev 命令行、创建包、cc65 工具链包与 Ember 调试 SDK",
  "license": "Apache-2.0",
  "author": "sungbin <sungbin@3578.cn>",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:libs": "node tools/build-libs.mjs",
    "boundaries": "node tools/check-structure.mjs",
    "pretest": "npm run build:libs",
    "test": "node --test \"packages/*/test/**/*.test.mjs\" \"test/**/*.test.mjs\"",
    "check": "npm run boundaries && npm test",
    "release:check": "node tools/release-check.mjs",
    "release:verify": "node tools/verify-install.mjs",
    "release:prepare": "node tools/release.mjs prepare",
    "release:publish": "node tools/release.mjs publish"
  }
}
