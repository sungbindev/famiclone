{
  "name": "ember-debug-sdk",
  "version": "0.7.0",
  "description": "Ember 调试服务的 SDK：类型完整的 WebSocket 客户端、终端客户端 ember-debug 与 MCP 服务 ember-debug-mcp。",
  "author": "sungbin <sungbin@3578.cn>",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/types/src/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "bin": {
    "ember-debug": "./dist/cli.js",
    "ember-debug-mcp": "./dist/mcp.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "schema": "npm --prefix ../../ember run schema",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "docs": "node scripts/docs.mjs && typedoc",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src test scripts",
    "test": "vitest run",
    "check": "npm run schema && npm run typecheck && npm run lint && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "oxlint": "^1.90.0",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  }
}
