{
  "name": "fcdev",
  "version": "0.9.0",
  "description": "6502 兼容机（NES、学习机等）的开发工具：用 cc65 构建 C 与汇编程序",
  "license": "Apache-2.0",
  "author": "sungbin <sungbin@3578.cn>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sungbindev/famiclone.git",
    "directory": "packages/fcdev"
  },
  "homepage": "https://github.com/sungbindev/famiclone#readme",
  "bugs": {
    "url": "https://github.com/sungbindev/famiclone/issues"
  },
  "keywords": [
    "6502",
    "nes",
    "famicom",
    "cc65",
    "ca65",
    "sb2000",
    "disassembler"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "fcdev": "bin/fcdev.mjs"
  },
  "scripts": {
    "prepack": "node ../../tools/build-libs.mjs && node debug-sdk/scripts/build.mjs && tsc -p tsconfig.types.json",
    "types:build": "tsc -p tsconfig.types.json",
    "debug-sdk:schema": "npm --prefix ../../ember run schema",
    "debug-sdk:typecheck": "tsc -p debug-sdk/tsconfig.json",
    "debug-sdk:lint": "oxlint -c debug-sdk/.oxlintrc.json --deny-warnings debug-sdk/src debug-sdk/test debug-sdk/scripts",
    "debug-sdk:build": "node debug-sdk/scripts/build.mjs",
    "debug-sdk:test": "vitest run --root debug-sdk",
    "debug-sdk:docs:protocol": "node debug-sdk/scripts/docs.mjs",
    "debug-sdk:docs": "node debug-sdk/scripts/docs.mjs && typedoc --options debug-sdk/typedoc.json",
    "debug-sdk:check": "npm run debug-sdk:schema && npm run debug-sdk:typecheck && npm run debug-sdk:lint && npm run debug-sdk:build && npm run debug-sdk:test"
  },
  "files": [
    "bin",
    "CHANGELOG.md",
    "dist",
    "docs",
    "src",
    "targets"
  ],
  "optionalDependencies": {
    "fcdev-cc65": "0.9.0",
    "fcdev-ember": "0.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "oxlint": "^1.90.0",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  }
}
