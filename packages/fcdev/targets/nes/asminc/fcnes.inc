; 作者：sungbin
; 邮箱：sungbin@3578.cn
; 日期：2026-11-10
; 备注：只含符号定义，不占空间。
; ------------------------------------------------------------------------
PPUCTRL   = $2000   ; 控制寄存器：名称表、图案表、NMI
PPUMASK   = $2001   ; 显示开关：背景、精灵
PPUSTATUS = $2002   ; 状态：位 7 为垂直消隐；读取会复位 PPUADDR 与 PPUSCROLL 的写入顺序
OAMADDR   = $2003   ; 精灵内存地址
OAMDATA   = $2004   ; 精灵内存数据
PPUSCROLL = $2005   ; 滚动，连续写两次：水平、垂直
PPUADDR   = $2006   ; 显存地址，连续写两次：高字节、低字节
PPUDATA   = $2007   ; 显存数据，写入后地址自动递增
