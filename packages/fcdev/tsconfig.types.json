{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist/types",
    "types": ["node"]
  },
  "include": ["src/disasm/**/*.mjs", "src/shared/**/*.mjs", "src/toolchain/**/*.mjs"]
}
