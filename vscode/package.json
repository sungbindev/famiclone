{
  "name": "fcdev",
  "displayName": "fcdev 6502 开发",
  "description": "6502 兼容机（NES、小霸王学习机等）开发：ca65 汇编的语法高亮、悬停、补全、转到定义与符号，cc65 的 C 头文件配置，以及给 Copilot 用的 6502 反汇编工具。",
  "version": "0.2.0",
  "publisher": "sungbin",
  "license": "Apache-2.0",
  "author": "sungbin <sungbin@3578.cn>",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "6502",
    "cc65",
    "ca65",
    "nes",
    "famicom",
    "fcdev",
    "disassembler",
    "copilot"
  ],
  "extensionPack": [
    "ms-vscode.cpptools"
  ],
  "main": "./out/bootstrap/extension.js",
  "activationEvents": [
    "workspaceContains:fcdev.json",
    "workspaceContains:**/disasm.json",
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ca65",
        "aliases": [
          "ca65 汇编",
          "ca65"
        ],
        "extensions": [
          ".s",
          ".asm",
          ".inc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ca65",
        "scopeName": "source.ca65",
        "path": "./syntaxes/ca65.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "fcdev.syncIntelliSense",
        "title": "fcdev：同步 C/C++ 智能感知配置"
      }
    ],
    "configuration": {
      "title": "fcdev",
      "properties": {
        "fcdev.intelliSense.autoSync": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "打开 fcdev 项目、修改 `fcdev.json` 时，自动运行 `fcdev sync`，让 C/C++ 扩展与 clangd 找到 cc65 的头文件与宏。"
        },
        "fcdev.intelliSense.promptConfigurationSelection": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "同步后，如果 `.vscode/c_cpp_properties.json` 里除 `fcdev` 外还有其他配置，提示你在 C/C++ 扩展里选择 `fcdev` 配置，每个项目每次会话只提示一次。"
        }
      }
    },
    "languageModelTools": [
      {
        "name": "disasm_open",
        "tags": [
          "6502",
          "disassembly",
          "fcdev"
        ],
        "toolReferenceName": "disasm_open",
        "displayName": "打开或新建反汇编工程",
        "modelDescription": "打开已有的反汇编工程，或由映像文件新建工程。只给 projectDir 就是打开（返回布局、入口数与进度）；再给 image 就是新建，工程文件 disasm.json 写在 projectDir 里。映像格式缺省按文件头判断：以 NES 加 0x1A 开头的是 iNES（只支持 NROM，入口自动取中断向量），其他是平铺二进制，必须给加载地址 address，有换页（bank）时改给 segments（每段：id、fileOffset、length、address，可选 bank、writable）。entries 是手工入口，symbolSets 是符号集（.inc）文件路径，登记后源码里用它们的名字代替硬件寄存器地址。新建后用 disasm_trace 追踪。",
        "userDescription": "打开或新建 6502 反汇编工程。",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectDir": {
              "type": "string",
              "minLength": 1,
              "description": "反汇编工程目录（里面有 disasm.json），工作区里的绝对路径或相对工作区根目录的路径"
            },
            "image": {
              "type": "string",
              "minLength": 1,
              "description": "要反汇编的映像文件（.nes、.bin、.exe 等）；不给则打开已有工程"
            },
            "format": {
              "type": "string",
              "enum": [
                "ines",
                "flat"
              ],
              "description": "映像格式：ines 或 flat（平铺二进制）；缺省按文件头判断"
            },
            "address": {
              "type": [
                "string",
                "integer"
              ],
              "description": "平铺二进制的加载地址，如 \"$8000\""
            },
            "segments": {
              "type": "array",
              "description": "平铺二进制的段列表（有换页时用）；每段：id、fileOffset、length、address，可选 bank、writable",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "fileOffset",
                  "length",
                  "address"
                ],
                "properties": {
                  "id": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "fileOffset": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "length": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "address": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "bank": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "writable": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            },
            "entries": {
              "type": "array",
              "description": "手工入口：地址，或 { address, segmentId }",
              "items": {
                "type": [
                  "string",
                  "integer",
                  "object"
                ]
              }
            },
            "symbolSets": {
              "type": "array",
              "description": "符号集文件（.inc）路径",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "vectors": {
              "type": "boolean",
              "description": "是否把中断向量当作入口，默认 true"
            },
            "overwrite": {
              "type": "boolean",
              "description": "工程已存在时是否覆盖，默认 false"
            }
          },
          "required": [
            "projectDir"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "disasm_status",
        "tags": [
          "6502",
          "disassembly",
          "fcdev"
        ],
        "toolReferenceName": "disasm_status",
        "displayName": "反汇编工程进度",
        "modelDescription": "查看反汇编工程的进度：映像与布局、各类区域占的字节、自动命名的符号数（要替换成有意义的名字）、没有说明的例程数、未解析的间接跳转与跨 bank 转移，以及最近一次回读校验的结果（一致、不一致、已过期、没做过）。每做完一批编辑后看一次。",
        "userDescription": "查看反汇编工程的进度。",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectDir": {
              "type": "string",
              "minLength": 1,
              "description": "反汇编工程目录（里面有 disasm.json），工作区里的绝对路径或相对工作区根目录的路径"
            }
          },
          "required": [
            "projectDir"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "disasm_layout",
        "tags": [
          "6502",
          "disassembly",
          "fcdev"
        ],
        "toolReferenceName": "disasm_layout",
        "displayName": "查看或替换布局",
        "modelDescription": "查看工程的布局（每段的文件偏移、长度、CPU 地址、bank）、没有划入任何段的字节范围和各类区域的字节数。给 segments 就是用新的段列表替换布局：手工标注的区域会被丢弃，仍然有效的入口、符号、注释、提示保留，其余丢弃并报告个数；替换后要重新 disasm_trace。",
        "userDescription": "查看或替换反汇编工程的布局。",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectDir": {
              "type": "string",
              "minLength": 1,
              "description": "反汇编工程目录（里面有 disasm.json），工作区里的绝对路径或相对工作区根目录的路径"
            },
            "segments": {
              "type": "array",
              "description": "新的段列表；每段：id、fileOffset、length、address，可选 bank、writable",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "fileOffset",
                  "length",
                  "address"
                ],
                "properties": {
                  "id": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "fileOffset": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "length": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "address": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "bank": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "writable": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "required": [
            "projectDir"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "disasm_hex",
        "tags": [
          "6502",
          "disassembly",
          "fcdev"
        ],
        "toolReferenceName": "disasm_hex",
        "displayName": "十六进制视图",
        "modelDescription": "以十六进制与字符形式查看一段字节：按 CPU 地址对齐，行尾标出符号，另外返回这段范围里的区域（类型与来源）。用于看数据、字符串、图形、地址表。默认从段首看 256 字节，最多 4096。",
        "userDescription": "查看一段字节的十六进制与字符视图。",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectDir": {
              "type": "string",
              "minLength": 1,
              "description": "反汇编工程目录（里面有 disasm.json），工作区里的绝对路径或相对工作区根目录的路径"
            },
            "address": {
              "type": [
                "string",
                "integer"
              ],
              "description": "CPU 地址：整数，或十六进制文字如 \"$C000\""
            },
            "segmentId": {
              "type": "integer",
              "minimum": 0,
              "description": "段号；同一个 CPU 地址在多个 bank 里都有映射（换页窗口）时必须给"
            },
            "length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096,
              "description": "字节数，默认 256"
            },
            "bytesPerRow": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64,
              "description": "每行字节数，默认 16"
            }
          },
          "required": [
            "projectDir"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "disasm_find",
        "tags": [
          "6502",
          "disassembly",
          "fcdev"
        ],
        "toolReferenceName": "disasm_find",
        "displayName": "搜索字节、文本、指令",
        "modelDescription": "在映像里搜索。kind 为 bytes：pattern 写十六进制字节，?? 匹配任意字节，如 \"A9 ?? 8D 00 20\"；kind 为 text：text 写 ASCII 文本，encoding 为 ascii-high 时每个字符的最高位为 1；kind 为 instructions：pattern 写连续的指令，分号分隔，* 匹配任意文字，如 \"lda #*; sta $2000\"（零页写 $10，绝对寻址的小地址写成 a:$0010）。结果分页，cursor 取自上一页的 nextCursor。",
        "userDescription": "在映像里搜索字节、文本或指令。",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectDir": {
              "type": "string",
              "minLength": 1,
              "description": "反汇编工程目录（里面有 disasm.json），工作区里的绝对路径或相对工作区根目录的路径"
            },
            "kind": {
              "type": "string",
              "enum": [
                "bytes",
                "text",
                "instructions"
              ],
              "description": "搜索种类，默认 bytes"
            },
            "pattern": {
              "type": "string",
              "minLength": 1,
              "description": "bytes 与 instructions 的模式"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "description": "text 要找的文字"
            },
            "encoding": {
              "type": "string",
              "enum": [
                "ascii",
                "ascii-high"
              ],
              "description": "text 的编码，默认 ascii"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "description": "每页最多返回几项，默认 50"
            },
            "cursor": {
              "type": "string",
              "description": "上一页返回的 nextCursor，取下一页"
            }
          },
          "required": [
            "projectDir"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "disasm_trace",
        "tags": [
          "6502",
          "disassembly",
          "fcdev"
        ],
        "toolReferenceName": "disasm_trace",
        "displayName": "静态追踪",
        "modelDescription": "从入口静态追踪代码：沿控制流标出指令，识别经地址表分发的跳转，更新区域，并给新发现的调用目标、跳转目标、数据与变量自动命名（sub_、loc_、data_、var_ 加地址，中断向量入口叫 reset、nmi、irq）。entries 可以同时加入新入口（地址，或 { address, segmentId }）。返回指令总数与本次新增、例程数、新符号数、警告与未解析项；间接跳转与跨 bank 转移追不出去，需要用运行记录或 disasm_apply 加入口补上。",
        "userDescription": "从入口追踪代码并自动命名。",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "projectDir": {
              "type": "string",
              "minLength": 1,
              "description": "反汇编工程目录（里面有 disasm.json），工作区里的绝对路径或相对工作区根目录的路径"
            },
            "entries": {
              "type": "array",
              "description": "要新加的手工入口：地址，或 { address, segmentId }",
              "items": {
                "type": [
                  "string",
                  "integer",
                  "object"
                ]
              }
            },
            "autoName": {
              "type": "boolean",
              "description": "是否给新发现的地址自动命名，默认 true"
            }
          },
          "required": [
            "projectDir"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "disasm_list",
        "tags": [
          "6502",
          "disassembly",
          "fcdev"
        ],
        "toolReferenceName": "disasm_list",
        "displayName": "按类别列出",
        "modelDescription": "按类别列出工程里的项（分页）。category：entries 入口；routines 例程（含大小与是否有说明）；unresolved 未解析的间接跳转与跨 bank 转移；unknown 没有识别的字节范围；auto-symbols 还没有换成有意义名字的自动符号；uncommented-routines 没有块注释的例程。",
        "userDescription": "按类别列出入口、例程、未解析项、未识别字节等。",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
