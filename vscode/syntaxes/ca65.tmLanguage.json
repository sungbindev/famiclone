{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ca65 汇编",
  "scopeName": "source.ca65",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#label-definition" },
    { "include": "#constant-definition" },
    { "include": "#named-block" },
    { "include": "#conditional" },
    { "include": "#pseudo-function" },
    { "include": "#directive" },
    { "include": "#accumulator-operand" },
    { "include": "#flow-mnemonic" },
    { "include": "#mnemonic" },
    { "include": "#index-register" },
    { "include": "#number" },
    { "include": "#immediate" },
    { "include": "#local-label" },
    { "include": "#anonymous-reference" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.semicolon.ca65",
      "match": ";.*$"
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.ca65",
          "begin": "\"",
          "end": "\"|$"
        },
        {
          "name": "string.quoted.single.ca65",
          "begin": "'",
          "end": "'|$"
        }
      ]
    },
    "label-definition": {
      "patterns": [
        {
          "match": "^\\s*(@?[A-Za-z_][A-Za-z0-9_]*)(::?)(?!=)",
          "captures": {
            "1": { "name": "entity.name.function.label.ca65" },
            "2": { "name": "punctuation.separator.label.ca65" }
          }
        },
        {
          "match": "^\\s*(:)(?![:=+\\-])",
          "captures": {
            "1": { "name": "entity.name.function.label.anonymous.ca65" }
          }
        }
      ]
    },
    "constant-definition": {
      "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(:?=)",
      "captures": {
        "1": { "name": "variable.other.constant.ca65" },
        "2": { "name": "keyword.operator.assignment.ca65" }
      }
    },
    "named-block": {
      "patterns": [
        {
          "match": "(?<![\\w.])(\\.(?i:proc|macro|mac))\\s+(@?[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.directive.ca65" },
            "2": { "name": "entity.name.function.ca65" }
          }
        },
        {
          "match": "(?<![\\w.])(\\.(?i:scope|struct|enum))\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.directive.ca65" },
            "2": { "name": "entity.name.type.ca65" }
          }
        }
      ]
    },
    "conditional": {
      "name": "keyword.control.conditional.ca65",
      "match": "(?<![\\w.])\\.(?i:if[A-Za-z0-9_]*|elseif|else|endif)(?![\\w])"
    },
    "pseudo-function": {
      "name": "support.function.pseudo.ca65",
      "match": "(?<![\\w.])\\.(?i:bank|bankbyte|blank|concat|const|definedmacro|defined|hibyte|hiword|ident|left|lobyte|loword|match|mid|ref|referenced|right|sizeof|strat|string|strlen|tcount|time|version|xmatch|cpu|paramcount|asize|isize|addrsize)(?![\\w])"
    },
    "directive": {
      "name": "keyword.other.directive.ca65",
      "match": "(?<![\\w.])\\.[A-Za-z_][A-Za-z0-9_]*"
    },
    "accumulator-operand": {
      "match": "(?<![\\w.@$])((?i:asl|lsr|rol|ror))\\s+((?i:a))(?![\\w])",
      "captures": {
        "1": { "name": "keyword.other.mnemonic.ca65" },
        "2": { "name": "variable.language.register.ca65" }
      }
    },
    "flow-mnemonic": {
      "name": "keyword.control.flow.ca65",
      "match": "(?<![\\w.@$])(?i:bcc|bcs|beq|bmi|bne|bpl|bvc|bvs|jmp|jsr|rts|rti|brk)(?![\\w])"
    },
    "mnemonic": {
      "name": "keyword.other.mnemonic.ca65",
      "match": "(?<![\\w.@$])(?i:adc|and|asl|bit|clc|cld|cli|clv|cmp|cpx|cpy|dec|dex|dey|eor|inc|inx|iny|lda|ldx|ldy|lsr|nop|ora|pha|php|pla|plp|rol|ror|sbc|sec|sed|sei|sta|stx|sty|tax|tay|tsx|txa|txs|tya)(?![\\w])"
    },
    "index-register": {
      "match": "(,)\\s*((?i:x|y))(?![\\w])",
      "captures": {
        "1": { "name": "punctuation.separator.comma.ca65" },
        "2": { "name": "variable.language.register.ca65" }
      }
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.ca65",
          "match": "\\$[0-9A-Fa-f]+(?![\\w])"
        },
        {
          "name": "constant.numeric.binary.ca65",
          "match": "(?<![\\w)\\]])%[01]+(?![\\w])"
        },
        {
          "name": "constant.numeric.decimal.ca65",
          "match": "(?<![\\w$%@.])[0-9]+(?![\\w])"
        }
      ]
    },
    "immediate": {
      "name": "keyword.operator.immediate.ca65",
      "match": "#"
    },
    "local-label": {
      "name": "variable.other.local.ca65",
      "match": "@[A-Za-z_][A-Za-z0-9_]*"
    },
    "anonymous-reference": {
      "name": "variable.other.anonymous.ca65",
      "match": ":[+\\-]+"
    },
    "operator": {
      "name": "keyword.operator.ca65",
      "match": "[-+*/&|^~<>!=]"
    }
  }
}
