; ------------------------------------------------------------------------
; 名称：bbg.inc
; 说明：步步高学生电脑 BBGDOS 程序用的 DOS 调用入口与功能号。
; 作者：sungbin
; 邮箱：sungbin@3578.cn
; 日期：2026-11-23
; 备注：功能与参数取自《步步高多媒体学生电脑 BIOS 系统 DOS 系统使用手册》系统篇第五章；只列出在
;       Ember 里用软驱一号的 ROM 验证过的项。调用方法：功能号放在 A，其他参数视功能而定，JSR 到
;       DOS_ENTRY；返回时进位为 0 表示成功，为 1 表示出错，A 是出错码；寄存器内容不保留。
; ------------------------------------------------------------------------

; DOS 调用入口（固定地址，JSR 调用）
DOS_ENTRY               = $580C

; DOS 功能号（放在 A）
DOS_PROGRAM_RETURN      = 0             ; 程序结束返回：X 返回码，Y 位 0=1 先初始化屏幕，位 1=1 先初始化系统资源
DOS_READ_KEY_ECHO       = 1             ; 读键盘并回显：返回 A 字符码
DOS_DISPLAY_CHAR        = 2             ; 显示字符：X 字符码，$0D、$0A 换行
DOS_READ_KEY_NO_ECHO    = 7             ; 读键盘不回显：返回 A 字符码
DOS_INITIAL_SCREEN      = 9             ; 初始化屏幕（清屏）
