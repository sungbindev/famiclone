; ------------------------------------------------------------------------
; 名称：sb97.inc
; 说明：SB97 DOS 程序用的硬件寄存器与 DOS 约定的地址。
; 作者：sungbin
; 邮箱：sungbin@3578.cn
; 日期：2026-11-23
; 备注：只列出 apps/sb97/runnes 里用过并在模拟器里验证过的项；整机寄存器的完整说明见 machines/sb97/docs。
; ------------------------------------------------------------------------

; PPU
PPU_CTRL        = $2000         ; 位 4 为背景图案表选择；SB97 的字库在图案表 1，显示文字要置位
PPU_MASK        = $2001         ; 位 3 显示背景
PPU_SCROLL      = $2005
PPU_ADDR        = $2006
PPU_DATA        = $2007

; 整机寄存器
PRAM_SEL        = $5000         ; 程序页选择，位 7 为 1 时选程序 RAM
MIRROR          = $5200         ; 位 0 镜像，位 2 为 32K 模式

; 软驱控制器（uPD765）
FDC_DCR         = $5500         ; 数据速率
FDC_DOR         = $5501         ; 数字输出寄存器：电机、复位
FDC_DATAW       = $5505         ; 数据寄存器（写）
FDC_MSR         = $5604         ; 主状态寄存器（读）
FDC_DATAR       = $5605         ; 数据寄存器（读）

; DOS 约定
DOS_ARGUMENT    = $680E         ; 命令行的第一个参数：大写、以 0 结尾，最多 14 个字符
