; ROM 的功能入口（固定区，JSR 调用）
BIOS_INIT_TEXT  = $F000         ; 初始化文字屏
BIOS_CLEAR      = $F05D         ; 清屏
BIOS_PRINT      = $F045         ; 显示字符串：A 为地址低字节，Y 为地址高字节

; 字符串控制码（BIOS_PRINT 的字符串）
STR_LOCATE      = $15           ; 后面跟 2 个字节：列、行，下一个字符显示在这里
STR_END         = $9F           ; 字符串结束
